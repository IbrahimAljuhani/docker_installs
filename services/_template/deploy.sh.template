#!/bin/bash
# deploy.sh template for a new service under services/<category>/<name>/.
# Copy this file to services/<category>/<name>/deploy.sh (pick the category
# from services/services.sh's CATALOG array — add a new category there if
# none fit), replace <service>/<SERVICE> placeholders, and adapt the
# prompts/generated files to the service's needs.
# See services/ERP/odoo/deploy.sh for a full-featured example of this same pattern
# (prereq checks, port validation, secret generation, main-net wiring).
#
# Convention: this script's own folder (services/<category>/<name>/ in the
# repo) holds the SOURCE docker-compose.yml/.env you edit and commit (.env
# excluded via .gitignore). Actual runtime state (containers, bind-mounted
# data) lives under ~/docker/<name>/ (flat, no category — the same root used
# by install_dockhub.sh and every other service) — so the whole host's state
# stays backupable as one ~/docker/ tree. Never generate data/db-data/etc.
# inside the repo folder.
#
# In your new service's own README, document running this as
# `bash deploy.sh` (not `chmod +x deploy.sh && ./deploy.sh`) — a fresh
# `git clone`/`git pull` doesn't reliably preserve the executable bit, and
# `bash <file>` works regardless of it. Same for any curl-then-run snippet.

set -euo pipefail

SERVICE_NAME="<service>"
SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$HOME/docker/$SERVICE_NAME"
LOGFILE="$RUNTIME_DIR/deploy.log"

# Shared helpers (print_info/print_warn/print_error, prompt_mem_limit,
# prompt_host_port, generate_secret, ensure_main_net, backup/restore
# generics, environment-detection reader) — sourced from a git checkout if
# present, self-fetched otherwise so a standalone `curl -O deploy.sh &&
# curl -O docker-compose.yml && bash deploy.sh` still works with no extra
# steps for the user. Don't duplicate these functions in your own deploy.sh
# — that's exactly the copy-paste drift this file replaced.
LIB_COMMON="$SOURCE_DIR/../../../lib/common.sh"
if [[ ! -f "$LIB_COMMON" ]]; then
    LIB_COMMON="$(mktemp -d)/common.sh"
    curl -fsSL -o "$LIB_COMMON" "https://raw.githubusercontent.com/IbrahimAljuhani/dockhub/main/lib/common.sh"
fi
# shellcheck source=/dev/null
source "$LIB_COMMON"

if [[ $EUID -eq 0 ]]; then
    print_error "This script must NOT be run as root. Please run as a regular user in the docker group."
fi

check_prerequisites   # sets COMPOSE_CMD, exits via print_error if anything's missing
ensure_main_net

[[ -f "$SOURCE_DIR/.env" ]] || print_error ".env not found in $SOURCE_DIR — copy .env.example to .env and fill it in first."
[[ -f "$SOURCE_DIR/docker-compose.yml" ]] || print_error "docker-compose.yml not found in $SOURCE_DIR."

mkdir -p "$RUNTIME_DIR"
if [[ -f "$RUNTIME_DIR/docker-compose.yml" ]]; then
    print_info "Existing deployment found at $RUNTIME_DIR — reusing it (source files not re-copied)."
else
    cp "$SOURCE_DIR/docker-compose.yml" "$SOURCE_DIR/.env" "$RUNTIME_DIR/"
    chmod 600 "$RUNTIME_DIR/.env"
    prompt_mem_limit "app" "512m"
    prompt_host_port "8080"
    [[ -n "$MEM_LIMIT" ]] && echo "MEM_LIMIT=$MEM_LIMIT" >> "$RUNTIME_DIR/.env"
    [[ -n "$HOST_PORT" ]] && echo "HOST_PORT=$HOST_PORT" >> "$RUNTIME_DIR/.env"
    # TODO if you wired in prompt_host_port: also set whatever HTTPS-only /
    # trusted-host env var(s) your app needs, conditional on HOST_PORT — an
    # app that forces HTTPS-only redirects or sets secure-only cookies by
    # default (common in OpenProject/Nextcloud/n8n-style apps) makes the
    # direct port completely unreachable otherwise (redirect loop, or the
    # browser silently refusing to send the cookie back over plain HTTP).
    # Same for any "trusted/allowed host" setting the app validates the Host
    # header against — it must become <server-ip>:<port> instead of a
    # placeholder domain. See services/Projects/openproject/deploy.sh,
    # services/Storage/nextcloud/deploy.sh, or services/Automation/n8n/deploy.sh
    # for three worked examples — this bug bit all three independently
    # before it became a fixed convention.
    print_info "Copied service files to $RUNTIME_DIR."
fi

# docker-compose.override.yml is fully owned by this script (never hand-edit
# it), so it's always safe to regenerate from whatever .env currently has.
# To change these later: edit MEM_LIMIT=/HOST_PORT= in $RUNTIME_DIR/.env (or
# delete the line to remove it), then rerun this script.
ENV_MEM_LIMIT=""
ENV_HOST_PORT=""
grep -q '^MEM_LIMIT=' "$RUNTIME_DIR/.env" 2>/dev/null && ENV_MEM_LIMIT=$(grep '^MEM_LIMIT=' "$RUNTIME_DIR/.env" | cut -d= -f2)
grep -q '^HOST_PORT=' "$RUNTIME_DIR/.env" 2>/dev/null && ENV_HOST_PORT=$(grep '^HOST_PORT=' "$RUNTIME_DIR/.env" | cut -d= -f2)

if [[ -n "$ENV_MEM_LIMIT" || -n "$ENV_HOST_PORT" ]]; then
    {
        echo "services:"
        echo "  app:"
        [[ -n "$ENV_MEM_LIMIT" ]] && echo "    mem_limit: $ENV_MEM_LIMIT"
        if [[ -n "$ENV_HOST_PORT" ]]; then
            echo "    ports:"
            echo "      - \"$ENV_HOST_PORT:8080\"" # adjust 8080 to your app's real container port
        fi
    } > "$RUNTIME_DIR/docker-compose.override.yml"
    [[ -n "$ENV_MEM_LIMIT" ]] && print_info "Memory limit $ENV_MEM_LIMIT applied to the 'app' container (db stays unbounded)."
    [[ -n "$ENV_HOST_PORT" ]] && print_info "Host port $ENV_HOST_PORT published for direct access."
else
    rm -f "$RUNTIME_DIR/docker-compose.override.yml"
fi

print_info "Starting $SERVICE_NAME..."
(cd "$RUNTIME_DIR" && $COMPOSE_CMD up -d 2>&1 | tee -a "$LOGFILE") \
    || print_error "Failed to start $SERVICE_NAME. Check log: $LOGFILE"

print_info "$SERVICE_NAME is running. Proxy target for NPM: ${SERVICE_NAME}-app (on main-net)."
print_tunnel_reminder_if_relevant

# ── Optional: DB-aware backup/restore ────────────────────────────────────
# If your service has a SEPARATE database container (Postgres/MySQL), do NOT
# define backup_<service>()/restore_<service>() in THIS file — services.sh
# only ever execs deploy.sh as its own process (never sources it, since
# everything above this point is top-level side-effecting code), so a
# function defined here would be invisible to it. Copy
# _template/backup.sh.template to services/<category>/<name>/backup.sh
# instead (function definitions only, safe to source) and add "backup.sh" to
# this service's entry in services.sh's SERVICE_FILES table. See
# services/Projects/vikunja/backup.sh for a worked example.
#
# Services with no separate database (SQLite-embedded, like this template
# assumes) don't need a backup.sh at all — the generic volume-based backup
# in lib/common.sh already covers them correctly.

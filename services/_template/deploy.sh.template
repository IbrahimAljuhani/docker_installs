#!/bin/bash
# deploy.sh template for a new service under services/<name>/.
# Copy this file to services/<name>/deploy.sh, replace <service>/<SERVICE>
# placeholders, and adapt the prompts/generated files to the service's needs.
# See services/odoo/deploy.sh for a full-featured example of this same pattern
# (prereq checks, port validation, secret generation, main-net wiring).
#
# Convention: this script's own folder (services/<name>/ in the repo) holds
# the SOURCE docker-compose.yml/.env you edit and commit (.env excluded via
# .gitignore). Actual runtime state (containers, bind-mounted data) lives
# under ~/docker/<name>/ — the same root used by install_dockhub.sh and
# services/odoo/deploy.sh — so the whole host's state stays backupable as one
# ~/docker/ tree. Never generate data/db-data/etc. inside the repo folder.
#
# In your new service's own README, document running this as
# `bash deploy.sh` (not `chmod +x deploy.sh && ./deploy.sh`) — a fresh
# `git clone`/`git pull` doesn't reliably preserve the executable bit, and
# `bash <file>` works regardless of it. Same for any curl-then-run snippet.

set -euo pipefail

SERVICE_NAME="<service>"
SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNTIME_DIR="$HOME/docker/$SERVICE_NAME"
LOGFILE="$RUNTIME_DIR/deploy.log"

print_info() { echo -e "[✓] $1" >&2; }
print_error() { echo -e "[✗] $1" >&2; exit 1; }

valid_mem_limit() { [[ "$1" =~ ^[0-9]+[bkmgBKMG]?$ ]]; }

# Prompts once (on first deploy only) for an optional memory cap on the
# 'app' container ('db' stays unbounded). Sets MEM_LIMIT in the caller's
# shell (no command substitution — keeps the prompt on a real terminal
# instead of risking it being swallowed into a captured value). Adjust the
# default and which service(s) it targets to fit your service.
MEM_LIMIT=""
prompt_mem_limit() {
    local default="$1" answer value
    read -rp "Set a memory limit for the 'app' container? (y/N): " answer
    [[ "${answer,,}" == "y" ]] || return 0
    while true; do
        read -rp "Memory limit (default: $default, e.g. 512m, 1g): " value
        value="${value:-$default}"
        if valid_mem_limit "$value"; then
            MEM_LIMIT="$value"
            return 0
        fi
        echo "Invalid format — use a number followed by b/k/m/g (e.g. 512m)." >&2
    done
}

valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1024 && 10#$1 <= 65535 )); }

port_in_use() {
    local port="$1"
    if command -v ss &>/dev/null; then
        ss -tuln 2>/dev/null | grep -q ":$port\b"
    elif command -v netstat &>/dev/null; then
        netstat -tuln 2>/dev/null | grep -q ":$port\b"
    else
        return 1
    fi
}

# Prompts once (on first deploy only) for an optional host port (direct
# access without NPM, e.g. for quick testing). Default is NO — every service
# in this repo reaches its app container by name over 'main-net' unless the
# user explicitly opts into a direct port. Sets HOST_PORT in the caller's
# shell (no command substitution — same reasoning as prompt_mem_limit above).
#
# IMPORTANT — read before wiring this into your service: if the app forces
# HTTPS-only redirects or sets secure-only cookies by default (common in
# OpenProject/Nextcloud/n8n-style apps), those must be flipped to their
# plain-HTTP-safe equivalents whenever HOST_PORT is set, or the direct port
# will be completely unreachable (redirect loop, or the browser silently
# refusing to send the cookie back over plain HTTP). Same for any
# "trusted/allowed host" setting the app validates the Host header against —
# it must become `<server-ip>:<port>` instead of a placeholder domain. See
# services/openproject/deploy.sh, services/nextcloud/deploy.sh, or
# services/n8n/deploy.sh for three worked examples of this exact pattern —
# this bug bit all three independently before it became a fixed convention.
HOST_PORT=""
prompt_host_port() {
    local default="$1" answer port cont
    read -rp "Also publish a host port for direct access without NPM (e.g. http://<server-ip>:<port>)? (y/N): " answer
    [[ "${answer,,}" == "y" ]] || return 0
    while true; do
        read -rp "Host port (default: $default): " port
        port="${port:-$default}"
        if ! valid_port "$port"; then
            echo "Invalid port — must be a number between 1024 and 65535." >&2
            continue
        fi
        if port_in_use "$port"; then
            read -rp "Port $port looks already in use — continue anyway? (y/N): " cont
            [[ "${cont,,}" == "y" ]] || continue
        fi
        HOST_PORT="$port"
        return 0
    done
}

# detect docker compose command
if docker compose version &>/dev/null; then
    COMPOSE_CMD="docker compose"
elif docker-compose version &>/dev/null; then
    COMPOSE_CMD="docker-compose"
else
    print_error "Docker Compose not found. Run install_dockhub.sh first."
fi

# Shared reverse-proxy network (created by install_dockhub.sh; created here
# too, idempotently, so this script also works standalone/out of order).
if ! docker network ls --format '{{.Name}}' | grep -qx "main-net"; then
    # '|| true': another service's deploy.sh may win a create race between the
    # check above and this line — that's harmless, but re-verify below so a
    # genuine failure isn't reported as OK.
    docker network create main-net || true
    if docker network ls --format '{{.Name}}' | grep -qx "main-net"; then
        print_info "Created docker network 'main-net'."
    else
        print_error "Failed to create docker network 'main-net'."
    fi
fi

[[ -f "$SOURCE_DIR/.env" ]] || print_error ".env not found in $SOURCE_DIR — copy .env.example to .env and fill it in first."
[[ -f "$SOURCE_DIR/docker-compose.yml" ]] || print_error "docker-compose.yml not found in $SOURCE_DIR."

mkdir -p "$RUNTIME_DIR"
if [[ -f "$RUNTIME_DIR/docker-compose.yml" ]]; then
    print_info "Existing deployment found at $RUNTIME_DIR — reusing it (source files not re-copied)."
else
    cp "$SOURCE_DIR/docker-compose.yml" "$SOURCE_DIR/.env" "$RUNTIME_DIR/"
    chmod 600 "$RUNTIME_DIR/.env"
    prompt_mem_limit "512m"
    prompt_host_port "8080"
    [[ -n "$MEM_LIMIT" ]] && echo "MEM_LIMIT=$MEM_LIMIT" >> "$RUNTIME_DIR/.env"
    [[ -n "$HOST_PORT" ]] && echo "HOST_PORT=$HOST_PORT" >> "$RUNTIME_DIR/.env"
    # TODO if you wired in prompt_host_port: also set whatever HTTPS-only /
    # trusted-host env var(s) your app needs, conditional on HOST_PORT — see
    # the comment above prompt_host_port's definition for why, and one of
    # openproject/nextcloud/n8n's deploy.sh for the exact pattern.
    print_info "Copied service files to $RUNTIME_DIR."
fi

# docker-compose.override.yml is fully owned by this script (never hand-edit
# it), so it's always safe to regenerate from whatever .env currently has.
# To change these later: edit MEM_LIMIT=/HOST_PORT= in $RUNTIME_DIR/.env (or
# delete the line to remove it), then rerun this script.
ENV_MEM_LIMIT=""
ENV_HOST_PORT=""
grep -q '^MEM_LIMIT=' "$RUNTIME_DIR/.env" 2>/dev/null && ENV_MEM_LIMIT=$(grep '^MEM_LIMIT=' "$RUNTIME_DIR/.env" | cut -d= -f2)
grep -q '^HOST_PORT=' "$RUNTIME_DIR/.env" 2>/dev/null && ENV_HOST_PORT=$(grep '^HOST_PORT=' "$RUNTIME_DIR/.env" | cut -d= -f2)

if [[ -n "$ENV_MEM_LIMIT" || -n "$ENV_HOST_PORT" ]]; then
    {
        echo "services:"
        echo "  app:"
        [[ -n "$ENV_MEM_LIMIT" ]] && echo "    mem_limit: $ENV_MEM_LIMIT"
        if [[ -n "$ENV_HOST_PORT" ]]; then
            echo "    ports:"
            echo "      - \"$ENV_HOST_PORT:8080\"" # adjust 8080 to your app's real container port
        fi
    } > "$RUNTIME_DIR/docker-compose.override.yml"
    [[ -n "$ENV_MEM_LIMIT" ]] && print_info "Memory limit $ENV_MEM_LIMIT applied to the 'app' container (db stays unbounded)."
    [[ -n "$ENV_HOST_PORT" ]] && print_info "Host port $ENV_HOST_PORT published for direct access."
else
    rm -f "$RUNTIME_DIR/docker-compose.override.yml"
fi

print_info "Starting $SERVICE_NAME..."
(cd "$RUNTIME_DIR" && $COMPOSE_CMD up -d 2>&1 | tee -a "$LOGFILE") \
    || print_error "Failed to start $SERVICE_NAME. Check log: $LOGFILE"

print_info "$SERVICE_NAME is running. Proxy target for NPM: ${SERVICE_NAME}-app (on main-net)."
